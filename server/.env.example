# Configurações do servidor Klyvochat
# Documentação de todas as variáveis de ambiente.

# --- Variáveis manuais (configurar via hPanel) ---
# PORT: porta do servidor Node.js (default: 8080)
# NODE_ENV: ambiente (production)
# JWT_SECRET: segredo para assinar tokens JWT — OBRIGATÓRIO gerar um valor seguro
#             (ex: `openssl rand -hex 32`). NUNCA use o valor de exemplo.
# JWT_EXPIRES_IN: expiração do access token (default: 15m)
# REFRESH_EXPIRES_IN: expiração do refresh token (default: 7d)

PORT=8080
NODE_ENV=production
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# --- Variáveis do database wizard (Hostinger) ---
# O database wizard do hPanel configura automaticamente estas variáveis
# ao criar o banco MySQL. NÃO as defina manualmente via .env importado,
# pois pode causar conflito com o wizard.
#
# DB_HOST: host do banco (ex: localhost ou 127.0.0.1)
# DB_PORT: porta do MySQL (default: 3306)
# DB_NAME: nome do banco de dados
# DB_USER: usuário do banco
# DB_PASSWORD: senha do banco

DB_HOST=localhost
DB_PORT=3306
DB_NAME=klyvochat
DB_USER=root
DB_PASSWORD=

# --- Instruções de deploy na Hostinger ---
# 1. Use o database wizard do hPanel para criar o banco MySQL.
#    Isso configura automaticamente as variáveis DB_*.
# 2. Importe `server/.env.production` via hPanel:
#    Environment Variables → Import .env
#    O .env.production contém APENAS as variáveis manuais (sem DB_*).
# 3. Nunca faça commit do .env com valores reais — use .env.example
#    e adicione .env ao .gitignore.